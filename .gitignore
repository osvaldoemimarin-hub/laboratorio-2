# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Secretos (FIRMS_MAP_KEY)
.env

# Datos generados por el pipeline (se regeneran con el DAG)
incendios_etl/data/bronze/*
incendios_etl/data/silver/*
incendios_etl/data/gold/*
!incendios_etl/data/gold/gold_final.csv
incendios_etl/data/warehouse/*
!incendios_etl/data/**/.gitkeep

# Muestra de una corrida (15-nov-2026) como evidencia de las capas Bronze y Silver
!incendios_etl/data/bronze/firms_viirs_noaa20_feed_20261115T223426Z.csv
!incendios_etl/data/bronze/bosque_banco_mundial_descarga_20261115T223426Z.xls
