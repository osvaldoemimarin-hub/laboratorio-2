# Modelos serializados (se regeneran)
incendios_etl/outputs/models/*
!incendios_etl/outputs/models/.gitkeep

# Airflow
airflow-incendios/logs/*
!airflow-incendios/logs/.gitkeep
airflow-incendios/config/airflow.cfg

